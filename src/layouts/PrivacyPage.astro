---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
import { routes, ui, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const isRu = locale === 'ru';
const labels = ui[locale];
---
<BaseLayout title={isRu ? 'Обработка данных — Автоэлектрик Берик' : 'Деректерді өңдеу — Автоэлектрик Берік'} description={isRu ? 'Информация об обработке данных и внешних сервисах на сайте автоэлектрика Берика.' : 'Автоэлектрик Берік сайтындағы деректерді өңдеу және сыртқы сервистер туралы ақпарат.'} locale={locale} routeKey="privacy">
  <Breadcrumbs locale={locale} items={[{ label: labels.home, href: routes.home[locale] }, { label: labels.privacy }]} />
  <article class="section legal-page container narrow">
    <span class="eyebrow">{isRu ? 'Прозрачно и по делу' : 'Ашық әрі түсінікті'}</span>
    <h1>{isRu ? 'Обработка данных' : 'Деректерді өңдеу'}</h1>
    {isRu ? <>
      <p class="lead">На сайте нет формы заявки, личного кабинета и базы данных клиентов.</p>
      <h2>Какие данные обрабатывает сайт</h2><p>При обычном просмотре статических страниц сайт самостоятельно не запрашивает имя, телефон или другие персональные данные. Нажатие на телефонную ссылку открывает приложение звонков на вашем устройстве.</p>
      <h2>WhatsApp и OLX</h2><p>Переход по кнопкам WhatsApp или OLX открывает сторонний сервис. Обработка данных в этих сервисах регулируется их собственными правилами и политиками.</p>
      <h2>Яндекс Карты</h2><p>На странице контактов загружается виджет Яндекс Карт. Яндекс может получать технические данные, необходимые для работы карты, в соответствии со своей политикой конфиденциальности. Если вы не хотите загружать виджет, используйте телефон или WhatsApp.</p>
      <h2>Аналитика</h2><p>Счётчики GA4 и Яндекс Метрики по умолчанию не подключены. Код сайта подготовлен для событий кликов, но данные никуда не отправляются, пока владелец не добавит идентификатор и счётчик.</p>
      <h2>Контакт</h2><p>По вопросам о данных свяжитесь с Бериком по телефону <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a>.</p>
    </> : <>
      <p class="lead">Сайтта өтінім нысаны, жеке кабинет және клиенттер дерекқоры жоқ.</p>
      <h2>Сайт қандай деректерді өңдейді</h2><p>Статикалық беттерді қарағанда сайт аты-жөніңізді, телефоныңызды немесе басқа жеке деректерді сұрамайды. Телефон сілтемесі құрылғыңыздағы қоңырау қолданбасын ашады.</p>
      <h2>WhatsApp және OLX</h2><p>WhatsApp немесе OLX батырмасы сыртқы сервисті ашады. Ондағы деректерді өңдеу сол сервистердің ережелері мен саясаттарына бағынады.</p>
      <h2>Яндекс Карта</h2><p>Байланыс бетінде Яндекс Карта виджеті жүктеледі. Яндекс картаның жұмысына қажетті техникалық деректерді өзінің құпиялық саясатына сай алуы мүмкін. Виджетті жүктегіңіз келмесе, телефон немесе WhatsApp пайдаланыңыз.</p>
      <h2>Аналитика</h2><p>GA4 және Яндекс Метрика есептегіштері әдепкіде қосылмаған. Сайт коды басу оқиғаларына дайын, бірақ иесі идентификатор мен есептегішті қоспайынша деректер жіберілмейді.</p>
      <h2>Байланыс</h2><p>Деректер туралы сұрақтар бойынша Берікке <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a> нөміріне хабарласыңыз.</p>
    </>}
  </article>
</BaseLayout>
