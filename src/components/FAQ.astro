---
export type FAQItem = { question: string; answer: string };
interface Props { items: FAQItem[]; title?: string; locale?: 'ru' | 'kk'; }
const { items, title = 'Частые вопросы', locale = 'ru' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---

<section class="section faq-section" id="faq">
  <div class="container narrow">
    <span class="eyebrow">{locale === 'ru' ? 'Полезно знать' : 'Пайдалы ақпарат'}</span>
    <h2>{title}</h2>
    <div class="faq-list">
      {items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
