---
import ServicePage from '../../layouts/ServicePage.astro';
import { getServicePages } from '../../data/servicePages';

export function getStaticPaths() {
  return getServicePages('kk').map(({ slug, data }) => ({ params: { slug }, props: data }));
}

const props: any = Astro.props;
---
<ServicePage locale="kk" {...props} />
